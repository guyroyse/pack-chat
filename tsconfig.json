{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "lib": ["ESNext"],
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lib/*": ["./lib/*"]
    }
  },
  "include": ["lib/**/*", "spec/**/*", "vitest.setup.ts"]
}
