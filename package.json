{
  "name": "packchat",
  "version": "0.1.0",
  "private": true,
  "description": "PackChat - Chat rooms over packet radio",
  "author": "Guy Royse <guy@guy.dev> (https://guy.dev)",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm --workspaces --if-present run build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "monitor": "npm --workspace @packchat/monitor run monitor"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/ui": "^4.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}
